shape_t broadcast_matmul_batch_shape(shape_t shape1, shape_t shape2) {
    ERROR_IF(rank(shape1) < 2);
    ERROR_IF(rank(shape2) < 2);

    int32_t shape1_batch_rank = rank(shape1) - 2;
    int32_t shape2_batch_rank = rank(shape2) - 2;
    int32_t output_batch_rank = (shape1_batch_rank > shape2_batch_rank) ? shape1_batch_rank : shape2_batch_rank;

    shape_t batch_shape1 = right_align_matmul_batch_shape(shape1, output_batch_rank);
    shape_t batch_shape2 = right_align_matmul_batch_shape(shape2, output_batch_rank);
    return broadcast_shape(batch_shape1, batch_shape2);
}
