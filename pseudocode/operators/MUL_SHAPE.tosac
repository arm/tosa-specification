ERROR_IF(length(input1) != length(input2));

for(int32_t index=0; index < length(input1); index++) {
    tensor_size_t a = input1[index];
    tensor_size_t b = input2[index];
    // Ensure the product is representable as a tensor_size_t
    if (a > 0 && b > 0) REQUIRE(a <= maximum_s<tensor_size_t>() / b);
    if (a < 0 && b < 0) REQUIRE(a >= maximum_s<tensor_size_t>() / b);
    if (a > 0 && b < 0) REQUIRE(b >= minimum_s<tensor_size_t>() / a);
    if (a < 0 && b > 0) REQUIRE(a >= minimum_s<tensor_size_t>() / b);
    output[index] = apply_mul_s<tensor_size_t>(a, b);
}
