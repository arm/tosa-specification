ERROR_IF(rank(shape1) != length(start) || rank(shape1) != length(size));
ERROR_IF(rank(shape1) != rank(shape));
// Sanity check the given coordinates, ensure start and end are
// within tensor bounds
for_each(0 <= index < rank(shape1)) {
    ERROR_IF(start[index] < 0);
    ERROR_IF(size[index] <= 0); //Output must be positive size
    ERROR_IF(start[index] + size[index] > shape1[index]);
    ERROR_IF(shape[index] != size[index]);
}

// Innermost dimensions of block-scaled values must contain whole blocks, and
// the slice must begin on a block boundary so that scales can be copied exactly.
ERROR_IF(is_block_scale<in_out_t>() &&
         shape1[rank(shape1) - 1] % get_innermost_block_size<in_out_t>() != 0);
ERROR_IF(is_block_scale<in_out_t>() &&
         shape[rank(shape) - 1] % get_innermost_block_size<in_out_t>() != 0);
ERROR_IF(is_block_scale<in_out_t>() &&
         start[rank(shape1) - 1] % get_innermost_block_size<in_out_t>() != 0);

for_each_data_position(index in shape) {
    shape_t tmp_index = index;
    for(int32_t i = 0; i < rank(shape); i++) {
       tmp_index[i] = index[i] + start[i];
    }
    value_scale_t<in_out_t> vs = tensor_read_value_scale<in_out_t>(input1, shape1, tmp_index);
    tensor_write_value_scale<in_out_t>(output, shape, index, vs);
}
