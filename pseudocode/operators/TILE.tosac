ERROR_IF(rank(shape1) != rank(shape));
ERROR_IF(is_block_scale<in_out_t>() &&
         shape1[rank(shape1) - 1] % get_innermost_block_size<in_out_t>() != 0);

for_each_data_position(index in shape) {
    shape_t tmp_index = index;
    for(int32_t i = 0; i < rank(shape); i++) {
        ERROR_IF(shape1[i] * multiples[i] != shape[i]);
        tmp_index[i] = index[i] % shape1[i];
    }
    value_scale_t<in_out_t> vs = tensor_read_value_scale<in_out_t>(input1, shape1, tmp_index);
    tensor_write_value_scale<in_out_t>(output, shape, index, vs);
}
