ERROR_IF(is_block_scale<in_out_t>() && C % get_innermost_block_size<in_out_t>() != 0);

for_each(0 <= n < N, 0 <= w < W, 0 <= c < C) {
    index_t k = tensor_read<index_t>(indices, [N,W], [n,w]);
    REQUIRE(0 <= k && k < K);
    value_scale_t<in_out_t> vs = tensor_read_value_scale<in_out_t>(values, [N,K,C], [n,k,c]);
    tensor_write_value_scale<in_out_t>(output, [N,W,C], [n,w,c], vs);
}
